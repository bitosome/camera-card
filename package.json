{
  "name": "camera-card",
  "version": "1.2.1",
  "description": "Focused Home Assistant camera card with UniFi Protect recordings and PTZ presets",
  "keywords": [
    "camera",
    "home-assistant",
    "hacs",
    "lovelace",
    "unifi-protect"
  ],
  "type": "module",
  "repository": "github:bitosome/camera-card",
  "license": "MIT",
  "dependencies": {
    "lit": "^3.1.4",
    "screenfull": "^6.0.2"
  },
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.6",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^21.1.2",
    "prettier": "^3.3.2",
    "rollup": "^3.29.4",
    "rollup-plugin-serve": "^1.1.1",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3",
    "vitest": "^1.6.0"
  },
  "scripts": {
    "start": "rollup -c --watch",
    "build": "yarn run lint && yarn run rollup",
    "format": "prettier --write .",
    "format-check": "prettier --check .",
    "lint": "eslint 'src/focused/**/*.ts' 'tests/focused/**/*.ts'",
    "rollup": "rollup -c",
    "test": "vitest run"
  },
  "volta": {
    "node": "22.14.0",
    "yarn": "4.9.1"
  }
}
